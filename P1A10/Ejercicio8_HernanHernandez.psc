//Calcular la suma de los cincuenta primeros números enteros.
Algoritmo Ejercicio8
	Definir X, S como Entero
	
	X <- 1
	S <- 0
	
	Mientras X <= 50 Hacer
		
		S <- S + X
		X <- X + 1
	FinMientras
	
	Escribir "La suma de los cincuenta números es: ", S
	
FinAlgoritmo
